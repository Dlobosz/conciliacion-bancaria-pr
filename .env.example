# Proveedor LLM: "anthropic" u "openai"
LLM_PROVIDER=anthropic

# API keys (copiar este archivo a .env y completar; .env nunca se sube al repo)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Modelo a usar para las excepciones (barato: solo procesa casos ambiguos)
LLM_MODEL=claude-haiku-4-5

# Ruta de la base de datos SQLite
DB_PATH=data/conciliacion.db
